@model RealEstatePortal.Web.ViewModels.LoginVM
@{
    ViewData["Title"] = "Customer & User Sign In";
}

<div class="row justify-content-center py-4">
    <div class="col-md-10 col-lg-7 col-xl-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="p-4 p-md-5">
                
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 bg-primary-subtle text-primary rounded-circle mb-2">
                        <i class="bi bi-person-circle fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">User Sign In</h3>
                    <p class="text-muted small">Sign in to schedule site visits, reserve properties, and manage rental contracts.</p>
                </div>

                <form asp-action="Login" method="post" id="userLoginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email / Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" id="userEmail" placeholder="your.email@example.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-1"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" type="password" class="form-control" id="userPassword" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberUser">
                        <label class="form-check-label small text-secondary" for="rememberUser">
                            Keep me signed in on this browser
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm mb-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Account
                    </button>
                </form>

                <div class="text-center pt-3 border-top small">
                    New User? 
                    <a asp-action="Register" class="text-primary fw-bold text-decoration-none">
                        Create an Account
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
