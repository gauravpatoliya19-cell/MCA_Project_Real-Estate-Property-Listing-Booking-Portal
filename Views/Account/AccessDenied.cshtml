@{
    ViewData["Title"] = "Access Restricted";
}

<div class="card border-0 shadow rounded-4 p-5 text-center bg-white my-4 mx-auto" style="max-width: 650px;">
    <div class="mb-3 text-danger">
        <i class="bi bi-shield-x display-1"></i>
    </div>
    <h3 class="fw-bold text-dark">Access Restricted</h3>
    <p class="text-muted mb-4">
        You do not have administrative permissions to view this resource. Please sign in with an Administrator or Agent account.
    </p>
    <div class="d-flex justify-content-center gap-3">
        <a asp-action="Login" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-house-door me-1"></i> Return Home
        </a>
    </div>
</div>
