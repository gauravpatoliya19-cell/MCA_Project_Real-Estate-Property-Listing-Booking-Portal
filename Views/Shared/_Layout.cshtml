<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Real Estate Property | Gujarat Portal</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Topbar info -->
    <div class="bg-dark text-white py-1 px-3 d-none d-md-block" style="font-size: 13px; background-color: #0b132b !important;">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-geo-alt-fill text-primary me-1"></i> Gujarat Real Estate Network</span>
                <span><i class="bi bi-telephone-fill text-primary me-1"></i> +91 98250 12345</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="text-white-50">
                        Hello, <strong class="text-white">@User.Identity.Name</strong>
                        <span class="badge bg-primary ms-1">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Customer")</span>
                    </span>
                    <a asp-area="Customer" asp-controller="MyAccount" asp-action="Index" class="text-info text-decoration-none fw-semibold">
                        <i class="bi bi-journal-bookmark me-1"></i> My Bookings & Visits
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Agent"))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-warning text-decoration-none fw-semibold ms-2">
                            <i class="bi bi-speedometer2 me-1"></i> Admin Console
                        </a>
                    }
                    <a asp-area="" asp-controller="Account" asp-action="Logout" class="text-danger text-decoration-none fw-semibold ms-2">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </a>
                }
                else
                {
                    <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="badge bg-warning text-dark text-decoration-none px-3 py-1 fw-bold rounded-pill">
                        <i class="bi bi-shield-lock-fill me-1"></i> Admin Portal Login &rarr;
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Main Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="bg-primary text-white p-2 rounded-3 me-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                    <i class="bi bi-building"></i>
                </div>
                <span>Real Estate <span class="text-primary">Property</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link px-3 text-white fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 text-white fw-semibold" asp-area="Customer" asp-controller="Catalog" asp-action="Index">
                            Browse Properties
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 text-white fw-semibold" asp-area="Customer" asp-controller="Catalog" asp-action="Index" asp-route-ListingType="Sale">
                            Buy
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 text-white fw-semibold" asp-area="Customer" asp-controller="Catalog" asp-action="Index" asp-route-ListingType="Rent">
                            Rent
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <!-- Site Visit Booking Cart Button -->
                    <a asp-area="Customer" asp-controller="BookingCart" asp-action="Index" class="btn btn-outline-light position-relative rounded-pill px-3 py-2">
                        <i class="bi bi-calendar-check me-1"></i> Visit Cart
                    </a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- My Bookings Button for Logged in User -->
                        <a asp-area="Customer" asp-controller="MyAccount" asp-action="Index" class="btn btn-info text-dark rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-bookmark-check-fill me-1"></i> My Bookings
                        </a>

                        @if (User.IsInRole("Admin") || User.IsInRole("Agent"))
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-warning text-dark rounded-pill px-3 py-2 fw-bold">
                                <i class="bi bi-speedometer2 me-1"></i> Admin Console
                            </a>
                        }

                        <div class="dropdown">
                            <button class="btn btn-outline-light rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; font-size: 12px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="small fw-semibold">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <div class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-dark">@User.Identity.Name</div>
                                        <span class="badge bg-primary-subtle text-primary">Role: @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Customer")</span>
                                    </div>
                                </li>
                                <li><a class="dropdown-item" asp-area="Customer" asp-controller="MyAccount" asp-action="Index"><i class="bi bi-bookmark-check me-2"></i> My Bookings & Visits</a></li>
                                <li><a class="dropdown-item" asp-area="Customer" asp-controller="BookingCart" asp-action="Index"><i class="bi bi-cart-check me-2"></i> View Visit Cart</a></li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Agent"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Admin Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Properties" asp-action="Index"><i class="bi bi-houses me-2"></i> Manage Properties</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2"></i> Manage Users</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Separate User Sign In & User Register -->
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> User Sign In
                        </a>
                        <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-person-plus-fill me-1"></i> User Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1">
        <div class="container py-4">
            <partial name="_NotificationPartial" />
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-white mt-auto pt-5 pb-3" style="background-color: #0b132b;">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center fw-bold fs-4 mb-3">
                        <i class="bi bi-building text-primary me-2"></i>
                        <span>Real Estate <span class="text-primary">Property</span> Gujarat Realty</span>
                    </div>
                    <p class="text-white-50 mb-3">
                        Premier full-service luxury real estate listing, scheduling, token payments, and rental contract platform in Gujarat.
                    </p>
                    <div class="d-flex gap-3 fs-5 text-white-50">
                        <a href="#" class="text-white-50 hover-primary"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white-50 hover-primary"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white-50 hover-primary"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-white-50 hover-primary"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="text-uppercase fw-bold text-white mb-3">Explore Properties</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-area="Customer" asp-controller="Catalog" asp-action="Index" class="text-white-50 text-decoration-none">All Properties</a></li>
                        <li class="mb-2"><a asp-area="Customer" asp-controller="Catalog" asp-action="Index" asp-route-PropertyType="Penthouse" class="text-white-50 text-decoration-none">Penthouses</a></li>
                        <li class="mb-2"><a asp-area="Customer" asp-controller="Catalog" asp-action="Index" asp-route-PropertyType="Villa" class="text-white-50 text-decoration-none">Luxury Villas</a></li>
                        <li class="mb-2"><a asp-area="Customer" asp-controller="Catalog" asp-action="Index" asp-route-PropertyType="Commercial" class="text-white-50 text-decoration-none">Commercial Hubs</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6 class="text-uppercase fw-bold text-white mb-3">Customer Transactions</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-area="Customer" asp-controller="Catalog" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-search me-1"></i> Multi-Filter Search</a></li>
                        <li class="mb-2"><a asp-area="Customer" asp-controller="BookingCart" asp-action="Index" class="text-white-50 text-decoration-none"><i class="bi bi-cart-check me-1"></i> Site Visit Booking Cart</a></li>
                        <li class="mb-2"><a asp-area="Customer" asp-controller="Payments" asp-action="Checkout" asp-route-propertyId="1" class="text-white-50 text-decoration-none"><i class="bi bi-credit-card me-1"></i> Token Gateway Checkout</a></li>
                        <li class="mb-2"><a asp-area="Customer" asp-controller="Contracts" asp-action="Generate" asp-route-propertyId="3" class="text-white-50 text-decoration-none"><i class="bi bi-file-earmark-pdf me-1"></i> Rental Contract Generator</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-3" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-white-50 small">
                <div>&copy; @DateTime.UtcNow.Year Real Estate Property Gujarat Realty Portal. All Rights Reserved.</div>
                <div>Project 13: Real Estate Property Listing & Booking Portal &bull; ASP.NET Core MVC</div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
