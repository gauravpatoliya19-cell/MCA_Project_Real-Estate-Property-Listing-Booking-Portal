@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-5">
    <div class="text-danger mb-3">
        <i class="bi bi-exclamation-octagon-fill display-1"></i>
    </div>
    <h2 class="fw-bold text-dark mb-2">An error occurred while processing your request.</h2>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">Return Home</a>
    </div>
</div>
