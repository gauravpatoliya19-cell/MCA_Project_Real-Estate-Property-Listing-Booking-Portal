<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal | Real Estate Property</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light admin-body">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark text-white border-end" id="sidebar-wrapper" style="width: 270px; min-height: 100vh; background-color: #0f172a !important;">
            <div class="sidebar-heading px-4 py-3 border-bottom border-secondary d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white p-2 rounded-3 me-2">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-white">Real Estate <span class="text-primary">Property</span></h6>
                        <small class="text-white-50" style="font-size: 11px;">ADMIN CONSOLE</small>
                    </div>
                </div>
            </div>

            <div class="p-3">
                <div class="text-uppercase text-white-50 fw-semibold mb-2 px-3" style="font-size: 11px; letter-spacing: 0.5px;">Main Operations</div>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item mb-1">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link text-white d-flex align-items-center py-2 px-3 rounded-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-primary" : "hover-dark")">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard Overview
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-area="Admin" asp-controller="Properties" asp-action="Index" class="nav-link text-white d-flex align-items-center py-2 px-3 rounded-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Properties" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active bg-primary" : "hover-dark")">
                            <i class="bi bi-houses me-2"></i> Manage Properties
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-area="Admin" asp-controller="Properties" asp-action="Create" class="nav-link text-white d-flex align-items-center py-2 px-3 rounded-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active bg-primary" : "hover-dark")">
                            <i class="bi bi-plus-circle-fill me-2 text-info"></i> Add New Listing
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="nav-link text-white d-flex align-items-center py-2 px-3 rounded-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active bg-primary" : "hover-dark")">
                            <i class="bi bi-people-fill me-2 text-warning"></i> Manage Users & Agents
                        </a>
                    </li>
                </ul>

                <div class="text-uppercase text-white-50 fw-semibold mt-4 mb-2 px-3" style="font-size: 11px; letter-spacing: 0.5px;">Analytical Reports</div>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item mb-1">
                        <a asp-area="Admin" asp-controller="Reports" asp-action="Ledger" class="nav-link text-white d-flex align-items-center py-2 px-3 rounded-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Ledger" ? "active bg-primary" : "hover-dark")">
                            <i class="bi bi-journal-check me-2 text-warning"></i> Property Status Ledger
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-area="Admin" asp-controller="Reports" asp-action="Commissions" class="nav-link text-white d-flex align-items-center py-2 px-3 rounded-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Commissions" ? "active bg-primary" : "hover-dark")">
                            <i class="bi bi-cash-stack me-2 text-success"></i> Commission Summary
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-area="Admin" asp-controller="Reports" asp-action="Conversions" class="nav-link text-white d-flex align-items-center py-2 px-3 rounded-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "Conversions" ? "active bg-primary" : "hover-dark")">
                            <i class="bi bi-funnel-fill me-2 text-info"></i> Conversion Rate Funnel
                        </a>
                    </li>
                </ul>

                <div class="text-uppercase text-white-50 fw-semibold mt-4 mb-2 px-3" style="font-size: 11px; letter-spacing: 0.5px;">Account</div>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item mb-1">
                        <a asp-area="" asp-controller="Account" asp-action="Logout" class="nav-link text-danger d-flex align-items-center py-2 px-3 rounded-3 hover-dark">
                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Page Content Wrapper -->
        <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column">
            <!-- Top Admin Navbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm px-4 py-3">
                <div class="container-fluid p-0">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill me-3">
                            <i class="bi bi-person-badge me-1"></i> @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Admin") Role Active
                        </span>
                        <h5 class="mb-0 fw-bold text-secondary">@ViewData["Title"]</h5>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <a asp-area="Admin" asp-controller="Properties" asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3">
                            <i class="bi bi-plus-lg me-1"></i> New Property
                        </a>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                            <i class="bi bi-person-plus me-1"></i> Add User
                        </a>
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 34px; height: 34px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-semibold small">@(User.Identity?.Name ?? "Executive Admin")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="dropdownUser1">
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2"></i> Manage Users</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Reports" asp-action="Ledger"><i class="bi bi-journal-text me-2"></i> Status Ledger</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i> Switch to Customer View</a></li>
                                <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Admin Container -->
            <div class="container-fluid p-4 flex-grow-1">
                <partial name="_NotificationPartial" />
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 px-4 text-muted small d-flex justify-content-between align-items-center">
                <span>&copy; @DateTime.UtcNow.Year Real Estate Property &bull; Admin Portal</span>
                <span>Project 13: Real Estate Property Listing & Booking Portal</span>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
