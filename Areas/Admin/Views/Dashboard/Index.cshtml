@{
    ViewData["Title"] = "Executive Admin Dashboard";
}

<!-- Welcome Banner -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row align-items-center">
        <div class="col-md-8">
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                <i class="bi bi-speedometer2 me-1"></i> Operations & Financial Overview
            </span>
            <h3 class="fw-bold mb-1 text-dark">Real Estate Operations Center</h3>
            <p class="text-muted mb-0">Live portal metrics, inventory status breakdown, token revenue, and inquiry conversion tracking.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-area="Admin" asp-controller="Properties" asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Property
            </a>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Ledger" class="btn btn-outline-secondary rounded-pill px-3 ms-2">
                <i class="bi bi-journal-text me-1"></i> View Ledger
            </a>
        </div>
    </div>
</div>

<!-- KPI Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Total Properties -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Total Portfolio</span>
                <div class="bg-primary-subtle text-primary p-2 rounded-3"><i class="bi bi-houses fs-5"></i></div>
            </div>
            <h3 class="fw-bold text-dark mb-1">@ViewBag.TotalProperties</h3>
            <div class="small">
                <span class="badge bg-success-subtle text-success me-1">@ViewBag.AvailableCount Available</span>
                <span class="badge bg-warning-subtle text-dark">@ViewBag.BookedCount Booked</span>
            </div>
        </div>
    </div>

    <!-- Escrow Token Revenue -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Escrow Tokens</span>
                <div class="bg-success-subtle text-success p-2 rounded-3"><i class="bi bi-cash-stack fs-5"></i></div>
            </div>
            <h3 class="fw-bold text-success mb-1">₹@ViewBag.TotalRevenue.ToString("N0")</h3>
            <div class="small text-muted">
                <i class="bi bi-shield-check text-success me-1"></i> Direct Gateway Tokens
            </div>
        </div>
    </div>

    <!-- Closed Commission Earned -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Est. Commissions</span>
                <div class="bg-warning-subtle text-warning p-2 rounded-3"><i class="bi bi-trophy fs-5"></i></div>
            </div>
            <h3 class="fw-bold text-dark mb-1">₹@ViewBag.TotalCommission.ToString("N0")</h3>
            <div class="small text-muted">
                <a asp-controller="Reports" asp-action="Commissions" class="text-decoration-none text-primary fw-semibold">View Commission Report &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Funnel Conversion Rate -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Conversion Rate</span>
                <div class="bg-info-subtle text-info p-2 rounded-3"><i class="bi bi-funnel fs-5"></i></div>
            </div>
            <h3 class="fw-bold text-primary mb-1">@ViewBag.ConversionRate%</h3>
            <div class="small text-muted">
                <span>@ViewBag.TotalContracts contracts from @ViewBag.TotalInquiries inquiries</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <!-- Property Distribution Chart -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill text-primary me-2"></i> Inventory Status Distribution</h6>
                <a asp-controller="Reports" asp-action="Ledger" class="text-decoration-none small text-primary">Ledger &rarr;</a>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="statusDoughnutChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Lead Funnel Pipeline Bar Chart -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-line-fill text-success me-2"></i> Transaction Flow & Funnel Pipeline</h6>
                <a asp-controller="Reports" asp-action="Conversions" class="text-decoration-none small text-primary">Funnel Report &rarr;</a>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="funnelBarChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions & Activity Tables -->
<div class="row g-4">
    <!-- Recent Token Payments -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-credit-card-fill text-primary me-2"></i> Recent Token Escrow Payments</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Receipt</th>
                            <th>Payer</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in (List<RealEstatePortal.Web.Models.TokenPayment>)ViewBag.RecentPayments)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace text-primary fw-bold">@p.ReceiptNumber</span>
                                    <div class="text-muted" style="font-size: 11px;">@p.PaymentDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@p.CustomerName</div>
                                    <div class="text-muted" style="font-size: 11px;">Prop #@p.PropertyId</div>
                                </td>
                                <td class="fw-bold text-success">₹@p.Amount.ToString("N0")</td>
                                <td><span class="badge bg-success-subtle text-success">@p.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Site Visit Bookings -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-event-fill text-warning me-2"></i> Scheduled Site Visit Bookings</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Visitor</th>
                            <th>Schedule Date</th>
                            <th>Time Slot</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in (List<RealEstatePortal.Web.Models.SiteVisitBooking>)ViewBag.RecentBookings)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@b.CustomerName</div>
                                    <div class="text-muted" style="font-size: 11px;">Prop #@b.PropertyId</div>
                                </td>
                                <td class="fw-bold text-dark">@b.VisitDate.ToString("MMM dd, yyyy")</td>
                                <td><span class="badge bg-light text-secondary border">@b.TimeSlot</span></td>
                                <td><span class="badge bg-primary-subtle text-primary">@b.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Doughnut Chart
            const ctxStatus = document.getElementById('statusDoughnutChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['Available', 'Booked', 'Rented', 'Sold'],
                    datasets: [{
                        data: [@ViewBag.AvailableCount, @ViewBag.BookedCount, @ViewBag.RentedCount, @ViewBag.SoldCount],
                        backgroundColor: ['#10b981', '#f59e0b', '#0ea5e9', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Funnel Pipeline Bar Chart
            const ctxFunnel = document.getElementById('funnelBarChart').getContext('2d');
            new Chart(ctxFunnel, {
                type: 'bar',
                data: {
                    labels: ['1. Inquiries', '2. Site Visits', '3. Token Payments', '4. Executed Contracts'],
                    datasets: [{
                        label: 'Total Volume',
                        data: [@ViewBag.TotalInquiries, @ViewBag.TotalSiteVisits, @(((List<RealEstatePortal.Web.Models.TokenPayment>)ViewBag.RecentPayments).Count), @ViewBag.TotalContracts],
                        backgroundColor: ['#3b82f6', '#06b6d4', '#f59e0b', '#10b981'],
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}
