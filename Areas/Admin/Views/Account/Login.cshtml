@model RealEstatePortal.Web.ViewModels.LoginVM
@{
    ViewData["Title"] = "Executive Admin Authentication";
    Layout = null; // Standalone dedicated admin layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Portal Login - Real Estate Property</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top right, #1e293b 0%, #0f172a 60%, #020617 100%);
            min-height: 100vh;
        }
        .admin-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                
                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 bg-warning text-dark rounded-4 shadow mb-3">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-1">Real Estate <span class="text-primary">Property</span></h3>
                    <div class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 11px;">
                        <i class="bi bi-shield-check me-1"></i> Executive Admin Portal
                    </div>
                    <p class="text-white-50 small mt-2">Restricted access for system administrators and licensed agents.</p>
                </div>

                <!-- Admin Card -->
                <div class="card admin-card text-white rounded-4 shadow-lg p-4 p-md-5">
                    <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" id="adminLoginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-white-50">Email / Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="Email" class="form-control bg-dark text-white border-secondary" id="adminEmail" placeholder="admin@realestateportal.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold text-white-50">Password</label>
                            <div class="input-group mt-1">
                                <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-key-fill"></i></span>
                                <input asp-for="Password" type="password" class="form-control bg-dark text-white border-secondary" id="adminPassword" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input bg-dark border-secondary" type="checkbox" asp-for="RememberMe" id="rememberAdmin">
                            <label class="form-check-label small text-white-50" for="rememberAdmin">
                                Remember admin credentials
                            </label>
                        </div>

                        <button type="submit" class="btn btn-warning text-dark w-100 rounded-pill py-2 fw-bold shadow mb-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Admin Console
                        </button>
                    </form>
                </div>

                <!-- Back to Public Site -->
                <div class="text-center mt-4">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none small me-3">
                        <i class="bi bi-house me-1"></i> Back to Homepage
                    </a>
                    <span class="text-white-50 small">&bull;</span>
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="text-primary text-decoration-none small ms-3">
                        <i class="bi bi-person-circle me-1"></i> Customer / User Login
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
