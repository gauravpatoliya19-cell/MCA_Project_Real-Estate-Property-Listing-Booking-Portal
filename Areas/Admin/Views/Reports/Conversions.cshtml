@model RealEstatePortal.Web.Areas.Admin.ViewModels.ConversionRateVM
@{
    ViewData["Title"] = "Inquiry Conversion Rate Report";
}

<!-- Report Header -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-info-subtle text-info-emphasis fw-bold px-3 py-2 rounded-pill mb-2">
                <i class="bi bi-funnel-fill me-1 text-info"></i> Dashboard Report #3
            </span>
            <h3 class="fw-bold mb-1 text-dark">Inquiry Conversion Rate Funnel</h3>
            <p class="text-muted mb-0">End-to-end sales funnel conversion pipeline: Inquiries &rarr; Site Visits &rarr; Token Payments &rarr; Closed Contracts.</p>
        </div>
        <div class="d-flex gap-2 no-print">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" onclick="window.print();">
                <i class="bi bi-printer-fill me-1"></i> Print Funnel
            </button>
            <a asp-action="Ledger" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-journal-text me-1"></i> Property Ledger
            </a>
        </div>
    </div>
</div>

<!-- Conversion Funnel Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Step 1: Inquiries -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-3 border-top border-primary border-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-bold">1. INQUIRIES</span>
                <i class="bi bi-chat-left-text-fill text-primary"></i>
            </div>
            <h3 class="fw-bold text-dark mb-0">@Model.TotalInquiries</h3>
            <small class="text-primary fw-semibold">100% Top of Funnel</small>
        </div>
    </div>

    <!-- Step 2: Site Visits -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-3 border-top border-info border-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-bold">2. SITE VISITS</span>
                <i class="bi bi-calendar-check-fill text-info"></i>
            </div>
            <h3 class="fw-bold text-dark mb-0">@Model.TotalSiteVisits</h3>
            <small class="text-info fw-semibold">@Model.InquiryToVisitRate.ToString("0.0")% of Inquiries</small>
        </div>
    </div>

    <!-- Step 3: Token Payments -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-3 border-top border-warning border-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-bold">3. TOKEN PAYMENTS</span>
                <i class="bi bi-credit-card-fill text-warning"></i>
            </div>
            <h3 class="fw-bold text-dark mb-0">@Model.TotalTokenPayments</h3>
            <small class="text-warning fw-semibold">@Model.VisitToPaymentRate.ToString("0.0")% of Visits</small>
        </div>
    </div>

    <!-- Step 4: Contracts -->
    <div class="col-6 col-lg-3">
        <div class="card metric-card bg-white p-3 border-top border-success border-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-bold">4. CLOSED CONTRACTS</span>
                <i class="bi bi-patch-check-fill text-success"></i>
            </div>
            <h3 class="fw-bold text-success mb-0">@Model.TotalContractsGenerated</h3>
            <small class="text-success fw-bold">@Model.OverallConversionRate.ToString("0.0")% Overall Rate</small>
        </div>
    </div>
</div>

<!-- Funnel Visual Progression -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-filter-circle-fill text-primary me-2"></i> Visual Conversion Funnel Stages</h6>
    <div class="d-flex flex-column gap-3">
        @foreach (var step in Model.FunnelSteps)
        {
            <div>
                <div class="d-flex justify-content-between align-items-center mb-1 small fw-semibold">
                    <span>@step.StepName</span>
                    <span>@step.Count Leads (@step.PercentageOfTotal%)</span>
                </div>
                <div class="funnel-bar-container">
                    <div class="funnel-bar bg-@step.ColorClass" style="width: @Math.Max(step.PercentageOfTotal, 5)%;">
                        @step.Count (@step.PercentageOfTotal%)
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Monthly Trend Chart -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-graph-up text-primary me-2"></i> Monthly Inquiry to Contract Conversion Trend</h6>
    <div style="position: relative; height: 300px;">
        <canvas id="monthlyTrendChart"></canvas>
    </div>
</div>

<!-- Property Conversion Performance Table -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-building me-2 text-primary"></i> Asset-Level Conversion Breakdown</h6>
        <span class="text-muted small">@Model.PropertyPerformances.Count monitored properties</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Property Asset</th>
                    <th>City</th>
                    <th>Status</th>
                    <th class="text-center">Inquiries</th>
                    <th class="text-center">Site Visits</th>
                    <th class="text-center">Token Payments</th>
                    <th class="text-center">Contracts</th>
                    <th class="text-end pe-4">Conversion Rate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.PropertyPerformances)
                {
                    <tr>
                        <td class="fw-bold text-dark">
                            <a asp-controller="Properties" asp-action="Details" asp-route-id="@p.PropertyId" class="text-dark text-decoration-none hover-primary">
                                @p.Title
                            </a>
                        </td>
                        <td>@p.City</td>
                        <td><span class="badge bg-light text-secondary border">@p.Status</span></td>
                        <td class="text-center">@p.Inquiries</td>
                        <td class="text-center">@p.Visits</td>
                        <td class="text-center">@p.Payments</td>
                        <td class="text-center fw-bold">@p.Contracts</td>
                        <td class="text-end pe-4">
                            <span class="badge @(p.ConversionRate > 0 ? "bg-success" : "bg-secondary") px-3 py-1 rounded-pill">
                                @p.ConversionRate.ToString("0.0")%
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const ctx = document.getElementById('monthlyTrendChart').getContext('2d');
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.MonthLabel)));
            const inquiries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.Inquiries)));
            const visits = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.SiteVisits)));
            const payments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.TokenPayments)));
            const contracts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.Contracts)));

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Inquiries',
                            data: inquiries,
                            borderColor: '#3b82f6',
                            backgroundColor: '#3b82f6',
                            tension: 0.3
                        },
                        {
                            label: 'Site Visits',
                            data: visits,
                            borderColor: '#06b6d4',
                            backgroundColor: '#06b6d4',
                            tension: 0.3
                        },
                        {
                            label: 'Token Payments',
                            data: payments,
                            borderColor: '#f59e0b',
                            backgroundColor: '#f59e0b',
                            tension: 0.3
                        },
                        {
                            label: 'Executed Contracts',
                            data: contracts,
                            borderColor: '#10b981',
                            backgroundColor: '#10b981',
                            borderWidth: 3,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        });
    </script>
}
