@model IEnumerable<RealEstatePortal.Web.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
}

<!-- Header Banner -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-2">
                <i class="bi bi-people-fill me-1"></i> User Access Control
            </span>
            <h4 class="fw-bold mb-1 text-dark">Registered Users & Administrators</h4>
            <p class="text-muted mb-0">Manage registered customer accounts and platform administrators.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add New User
            </a>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name, email, or phone...">
            </div>
        </div>
        <div class="col-md-4">
            <select name="role" class="form-select form-select-sm">
                <option value="">All Roles (Admin & Customers)</option>
                <!option value="Admin" @(ViewBag.CurrentRole == "Admin" ? "selected" : "")>Admins Only</!option>
                <!option value="Customer" @(ViewBag.CurrentRole == "Customer" ? "selected" : "")>Customers Only</!option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm rounded-pill flex-fill">
                <i class="bi bi-filter me-1"></i> Filter Users
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Email Address</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 38px; height: 38px;">
                                    @(u.FullName.Length > 0 ? u.FullName.Substring(0, 1).ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@u.FullName</div>
                                    <div class="text-muted" style="font-size: 11px;">ID: @u.Id.Substring(0, Math.Min(8, u.Id.Length))...</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-secondary">@u.Email</span>
                        </td>
                        <td>
                            <span class="text-secondary small">@(string.IsNullOrEmpty(u.PhoneNumber) ? "—" : u.PhoneNumber)</span>
                        </td>
                        <td>
                            @{
                                string roleClass = u.Role switch
                                {
                                    "Admin" => "bg-danger-subtle text-danger border border-danger-subtle",
                                    _ => "bg-info-subtle text-info border border-info-subtle"
                                };
                            }
                            <span class="badge @roleClass px-3 py-1 rounded-pill fw-semibold">
                                @u.Role
                            </span>
                        </td>
                        <td>
                            <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm p-0 border-0" title="Click to Toggle Active/Inactive">
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1">
                                            <i class="bi bi-dash-circle me-1"></i> Disabled
                                        </span>
                                    }
                                </button>
                            </form>
                        </td>
                        <td class="text-muted small">
                            @u.CreatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary rounded-pill" title="Edit User & Role">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete user @u.FullName?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete User">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
