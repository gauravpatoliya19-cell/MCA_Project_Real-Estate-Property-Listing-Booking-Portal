@model RealEstatePortal.Web.Models.Property
@{
    ViewData["Title"] = "Property Admin Inspector - " + Model.Title;
}

<!-- Header -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-secondary">Property #@Model.Id</span>
                <span class="badge bg-primary">@Model.ListingType</span>
                <span class="badge bg-info">@Model.PropertyType</span>
                @{
                    string statusBadge = Model.Status switch
                    {
                        PropertyStatus.Available => "bg-success",
                        PropertyStatus.Booked => "bg-warning text-dark",
                        PropertyStatus.Rented => "bg-info",
                        PropertyStatus.Sold => "bg-danger",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @statusBadge">@Model.Status</span>
            </div>
            <h4 class="fw-bold text-dark mb-0">@Model.Title</h4>
            <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Address, @Model.City, @Model.State @Model.ZipCode</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-area="Customer" asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3" target="_blank">
                <i class="bi bi-box-arrow-up-right me-1"></i> View Live
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>
</div>

<!-- Specs & Valuation Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <span class="text-muted small">Asset Valuation / Rent</span>
            <h4 class="fw-bold text-dark mb-0">@Model.FormattedPriceWithPeriod</h4>
            @if (Model.Price >= 100000m)
            {
                <small class="text-muted">₹@Model.Price.ToString("N0")</small>
            }
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <span class="text-muted small">Token Deposit Amount</span>
            <h4 class="fw-bold text-success mb-0">@Model.FormattedTokenAmount</h4>
            @if (Model.TokenAmount >= 100000m)
            {
                <small class="text-muted">₹@Model.TokenAmount.ToString("N0")</small>
            }
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <span class="text-muted small">Assigned Broker</span>
            <h5 class="fw-bold text-dark mb-0">@Model.AgentName</h5>
            <small class="text-muted">Rate: @Model.CommissionRate%</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <span class="text-muted small">Dimensions</span>
            <h5 class="fw-bold text-dark mb-0">@Model.AreaSqFt Sq Ft</h5>
            <small class="text-muted">@Model.Bedrooms Bed &bull; @Model.Bathrooms Bath</small>
        </div>
    </div>
</div>

<!-- Associated Multi-Table Data Tabs -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-4">
    <ul class="nav nav-pills mb-4" id="propertyAdminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="inquiries-tab" data-bs-toggle="pill" data-bs-target="#inquiries" type="button" role="tab">
                <i class="bi bi-chat-left-dots-fill me-1"></i> Inquiries (@Model.Inquiries.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="visits-tab" data-bs-toggle="pill" data-bs-target="#visits" type="button" role="tab">
                <i class="bi bi-calendar-event-fill me-1"></i> Site Visits (@Model.SiteVisits.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="payments-tab" data-bs-toggle="pill" data-bs-target="#payments" type="button" role="tab">
                <i class="bi bi-credit-card-fill me-1"></i> Token Payments (@Model.TokenPayments.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="contracts-tab" data-bs-toggle="pill" data-bs-target="#contracts" type="button" role="tab">
                <i class="bi bi-file-earmark-text-fill me-1"></i> Contracts (@Model.RentalContracts.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="propertyAdminTabsContent">
        <!-- Inquiries Tab -->
        <div class="tab-pane fade show active" id="inquiries" role="tabpanel">
            @if (!Model.Inquiries.Any())
            {
                <p class="text-muted text-center py-4">No inquiries received for this listing yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Inquirer</th>
                                <th>Contact</th>
                                <th>Message</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inq in Model.Inquiries.OrderByDescending(i => i.InquiryDate))
                            {
                                <tr>
                                    <td>@inq.InquiryDate.ToString("MMM dd, yyyy")</td>
                                    <td class="fw-bold">@inq.CustomerName</td>
                                    <td>@inq.CustomerEmail<br />@inq.CustomerPhone</td>
                                    <td>@inq.Message</td>
                                    <td><span class="badge bg-primary-subtle text-primary">@inq.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Site Visits Tab -->
        <div class="tab-pane fade" id="visits" role="tabpanel">
            @if (!Model.SiteVisits.Any())
            {
                <p class="text-muted text-center py-4">No site visit bookings recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Scheduled Date</th>
                                <th>Time Slot</th>
                                <th>Visitor</th>
                                <th>Contact</th>
                                <th>Notes</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.SiteVisits.OrderByDescending(s => s.VisitDate))
                            {
                                <tr>
                                    <td class="fw-bold">@v.VisitDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">@v.TimeSlot</span></td>
                                    <td class="fw-bold">@v.CustomerName</td>
                                    <td>@v.CustomerEmail<br />@v.CustomerPhone</td>
                                    <td>@v.Notes</td>
                                    <td><span class="badge bg-success-subtle text-success">@v.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Token Payments Tab -->
        <div class="tab-pane fade" id="payments" role="tabpanel">
            @if (!Model.TokenPayments.Any())
            {
                <p class="text-muted text-center py-4">No token payments processed for this property.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Receipt / Txn ID</th>
                                <th>Payer</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.TokenPayments.OrderByDescending(t => t.PaymentDate))
                            {
                                <tr>
                                    <td>
                                        <span class="font-monospace fw-bold text-primary">@p.ReceiptNumber</span>
                                        <div class="text-muted" style="font-size: 11px;">@p.TransactionId</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@p.CustomerName</div>
                                        <div class="text-muted" style="font-size: 11px;">@p.CustomerEmail</div>
                                    </td>
                                    <td class="fw-bold text-success">₹@p.Amount.ToString("N2")</td>
                                    <td>@p.PaymentMethod</td>
                                    <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-success">@p.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Contracts Tab -->
        <div class="tab-pane fade" id="contracts" role="tabpanel">
            @if (!Model.RentalContracts.Any())
            {
                <p class="text-muted text-center py-4">No executed contracts for this property.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Contract #</th>
                                <th>Tenant</th>
                                <th>Term</th>
                                <th>Monthly Rent</th>
                                <th>Deposit</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.RentalContracts.OrderByDescending(x => x.GeneratedAt))
                            {
                                <tr>
                                    <td><span class="font-monospace text-primary fw-bold">@c.ContractNumber</span></td>
                                    <td class="fw-bold">@c.TenantName</td>
                                    <td>@c.StartDate.ToString("MMM yyyy") &mdash; @c.EndDate.ToString("MMM yyyy")</td>
                                    <td class="fw-bold text-dark">₹@c.MonthlyRent.ToString("N2")</td>
                                    <td class="text-muted">₹@c.SecurityDeposit.ToString("N2")</td>
                                    <td><span class="badge bg-success">@c.Status</span></td>
                                    <td>
                                        <a asp-area="Customer" asp-controller="Contracts" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3" target="_blank">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> View Contract
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
