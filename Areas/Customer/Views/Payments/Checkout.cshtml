@model RealEstatePortal.Web.Areas.Customer.ViewModels.TokenPaymentVM
@{
    ViewData["Title"] = "Token Escrow Payment Checkout";
}

<div class="mb-4 p-4 rounded-4 shadow-sm bg-white border">
    <span class="badge bg-success-subtle text-success fw-semibold px-3 py-2 rounded-pill mb-2">
        <i class="bi bi-shield-lock-fill me-1"></i> Transaction: Token Payment Gateway
    </span>
    <h2 class="fw-bold mb-1 text-dark">Reserve Property with Token Escrow</h2>
    <p class="text-muted mb-0">Securely deposit your earnest reservation token to take this property off the open market.</p>
</div>

<form asp-action="Process" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PropertyId" />
    <input type="hidden" asp-for="Amount" />

    <div class="row g-4">
        <!-- Left: Payment Details Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-credit-card-2-front-fill text-primary me-2"></i> Payment Method & Billing</h5>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Payment Method Selector -->
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">Select Payment Gateway / Method</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="form-check p-3 border rounded-3 bg-light">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="@PaymentMethod.CreditCard" id="pmCard" checked>
                                <label class="form-check-label fw-bold text-dark ms-1" for="pmCard">
                                    <i class="bi bi-credit-card me-1 text-primary"></i> Credit / Debit Card
                                </label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check p-3 border rounded-3 bg-light">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="@PaymentMethod.WireTransfer" id="pmWire">
                                <label class="form-check-label fw-bold text-dark ms-1" for="pmWire">
                                    <i class="bi bi-bank me-1 text-success"></i> Escrow Wire Transfer
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payer Info -->
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label asp-for="CardHolderName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="CardHolderName" class="form-control" placeholder="Alexander Wright" required />
                        <span asp-validation-for="CardHolderName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CustomerEmail" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="CustomerEmail" class="form-control" placeholder="alexander@example.com" required />
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CustomerPhone" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="CustomerPhone" class="form-control" placeholder="+91 98250 12345" required />
                        <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Card Details -->
                <div class="p-3 rounded-3 bg-light border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary">Card Credentials (Simulated Gateway)</span>
                        <div>
                            <i class="bi bi-credit-card-2-back text-muted fs-5 me-1"></i>
                            <i class="bi bi-shield-check text-success fs-5"></i>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CardNumber" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-credit-card"></i></span>
                            <input asp-for="CardNumber" class="form-control font-monospace" placeholder="4242 4242 4242 4242" required />
                        </div>
                        <span asp-validation-for="CardNumber" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="Expiration" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Expiration" class="form-control font-monospace" placeholder="12/28" required />
                            <span asp-validation-for="Expiration" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Cvv" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Cvv" type="password" maxlength="4" class="form-control font-monospace" placeholder="123" required />
                            <span asp-validation-for="Cvv" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label small fw-semibold text-secondary"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes for closing coordinator..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow">
                    <i class="bi bi-lock-fill me-1"></i> Authorize & Pay ₹@Model.Amount.ToString("N2")
                </button>
            </div>
        </div>

        <!-- Right: Order Summary -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
                <h5 class="fw-bold text-dark mb-3">Reservation Summary</h5>

                @if (Model.Property != null)
                {
                    <div class="mb-3">
                        <img src="@Model.Property.PrimaryImageUrl" class="img-fluid rounded-3 shadow-sm mb-3" style="height: 180px; width: 100%; object-fit: cover;" alt="@Model.Property.Title">
                        <h6 class="fw-bold text-dark mb-1">@Model.Property.Title</h6>
                        <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Property.Address, @Model.Property.City</p>
                    </div>

                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Total Listing Valuation:</span>
                            <span class="fw-bold text-dark">@Model.Property.FormattedPriceWithPeriod <small class="text-muted fw-normal">(₹@Model.Property.Price.ToString("N0"))</small></span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Listing Type:</span>
                            <span class="badge bg-secondary">For @Model.Property.ListingType</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Assigned Broker:</span>
                            <span>@Model.Property.AgentName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 bg-light p-3 rounded-3 mt-2">
                            <span class="fw-bold text-dark">Escrow Token Deposit:</span>
                            <span class="fw-bold text-success fs-5">₹@Model.Amount.ToString("N2")</span>
                        </li>
                    </ul>
                }

                <div class="p-3 bg-light rounded-3 small text-secondary">
                    <div class="d-flex align-items-center mb-1">
                        <i class="bi bi-shield-lock-fill text-success fs-5 me-2"></i>
                        <span class="fw-bold text-dark">256-Bit Bank Level Encryption</span>
                    </div>
                    <span>Token is credited towards total purchase price or lease security deposit upon lease signing.</span>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
