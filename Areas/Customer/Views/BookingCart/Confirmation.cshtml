@model IEnumerable<RealEstatePortal.Web.Models.SiteVisitBooking>
@{
    ViewData["Title"] = "Site Visits Confirmed";
}

<div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-4">
    <div class="mb-3">
        <div class="bg-success-subtle text-success rounded-circle d-inline-flex p-3 fs-1">
            <i class="bi bi-calendar-check-fill"></i>
        </div>
    </div>
    <h3 class="fw-bold text-dark">Site Visit Appointments Confirmed!</h3>
    <p class="text-muted mx-auto" style="max-width: 600px;">
        We have reserved your appointment slots. A calendar invite and assigned agent details have been emailed to you.
    </p>

    <div class="text-start mt-4 mx-auto" style="max-width: 700px;">
        <h5 class="fw-bold mb-3">Your Scheduled Appointments:</h5>
        <div class="list-group shadow-sm">
            @foreach (var b in Model)
            {
                <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 fw-bold text-dark">Property #@b.PropertyId</h6>
                        <div class="text-muted small">
                            <i class="bi bi-calendar3 me-1 text-primary"></i> <strong>@b.VisitDate.ToString("dddd, MMMM dd, yyyy")</strong>
                            <span class="mx-2">&bull;</span>
                            <i class="bi bi-clock me-1 text-info"></i> @b.TimeSlot
                        </div>
                        @if (!string.IsNullOrEmpty(b.Notes))
                        {
                            <div class="text-secondary small mt-1"><i class="bi bi-chat-left-text me-1"></i> @b.Notes</div>
                        }
                    </div>
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                        <i class="bi bi-check-circle me-1"></i> @b.Status
                    </span>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-4">
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Catalog
        </a>
        <a asp-area="Admin" asp-controller="Reports" asp-action="Conversions" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-funnel me-1"></i> View Conversion Funnel
        </a>
    </div>
</div>
